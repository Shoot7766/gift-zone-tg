# Nusxa olib nomini .env qiling. BU FAYLGA haqiqiy kalit yozmang (faqat misol).

# Telegram: @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase: Settings → API
# URL loyiha API manzili bo'lishi kerak: https://XXXX.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Server uchun: service_role yoki "Secret" kalit (publishable emas)
SUPABASE_KEY=your_supabase_service_role_or_secret_key

# Mini ilova HTTPS manzili (Vercel yoki boshqa hosting).
# @BotFather → Bot → Bot Settings → Menu Button / Configure Mini App URL ham mos bo'lishi kerak.
MINI_APP_URL=https://your-mini-app.vercel.app

# Ixtiyoriy: boshqa skriptlar / kelajak modullari uchun
# ADMIN_TELEGRAM_IDS=123456789
