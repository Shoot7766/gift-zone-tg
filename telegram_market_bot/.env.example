# Nusxa olib nomini .env qiling. BU FAYLGA haqiqiy kalit yozmang (faqat misol).

# Telegram: @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase: Settings → API
# URL loyiha API manzili bo'lishi kerak: https://XXXX.supabase.co (dashboard havolasi EMAS)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server uchun: service_role yoki "Secret" kalit (publishable emas)
SUPABASE_KEY=your_supabase_service_role_or_secret_key

# OpenAI: platform.openai.com → API keys
OPENAI_API_KEY=sk-your-openai-api-key

# Admin (Telegram raqamingiz — @userinfobot dan tekshiring). Vergul bilan bir nechta ID.
# ADMIN_TELEGRAM_IDS=123456789

# Ixtiyoriy
# OPENAI_MODEL=gpt-4o-mini
# PRODUCT_SEARCH_LIMIT=10
# SEARCH_INITIAL_SHOW=3
# SEARCH_MORE_BATCH=7
