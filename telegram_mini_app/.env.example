# Supabase loyiha → Settings → API
# Mini App brauzerda ishlaydi — "anon" / "public" kalit ishlating (service_role EMAS).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Rolni aniqlash (/api/me): Telegram initData tekshiruvi + users jadvalidan o‘qish
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin Telegram ID lar (vergul bilan) — mini ilovada admin panel navigatsiyasi
ADMIN_TELEGRAM_IDS=123456789

# Sotuvchi panelidagi "Botga o‘tish" havolalari (username, @siz)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
